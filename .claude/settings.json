{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "fr",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(find . *)",
      "Bash(ls *)",
      "Bash(chmod +x *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; pnpm exec prettier --write \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Prettier..."
          }
        ]
      }
    ]
  }
}
